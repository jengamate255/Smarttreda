# MetaTrader 5 credentials (used by src/data/mt5_collector.py and src/cli.py paper/predict)
# Get these from your MT5 terminal: File -> Login to Trade Account
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Server

# Optional: path to terminal64.exe if not in default location
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Broker timezone offset relative to UTC (hours). copy_rates* returns naive
# timestamps in the terminal timezone; the collector converts to UTC using this.
# 0 = terminal already runs in UTC. European brokers often use +2 or +3.
# MT5_TZ_OFFSET_HOURS=0

# Colab/Drive sync (scripts/upload_dataset.py, scripts/download_model.py)
# GDRIVE_UPLOAD_METHOD=gdrive|rclone|none
# GDRIVE_FOLDER_ID=<google drive folder id>
# GDRIVE_REMOTE=gdrive

# LIVE trading requires BOTH config execution.mode: LIVE AND this env var.
# NEVER set this to 1 unless you fully understand the consequences.
MT5_ALLOW_LIVE=0

# Google Colab Integration Configuration
# Copy this file to .env and fill in your values, or set as Colab Secrets

# Repository settings
MT5_REPO=https://github.com/jengamate255/Superbot-.git
MT5_REPO_DIR=/content/mt5-ea

# Google Drive
MT5_MOUNT_DRIVE=1

# Deriv API Configuration
# Default shared app_id (1089) only provides synthetic indices
# Register your own at https://api.deriv.com/ for forex/commodities
DERIV_APP_ID=1089
DERIV_API_TOKEN=
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3

# Default analysis settings
MT5_SYMBOL=R_100
MT5_TIMEFRAME=M1

# Backtest settings
MT5_BACKTEST_SYMBOL=BOOM1000
MT5_BACKTEST_BARS=1000

# Walk-forward settings
MT5_WF_SYMBOL=R_100
MT5_WF_BARS=2000

# ML training settings
MT5_ML_SYMBOL=R_100
MT5_ML_BARS=2000